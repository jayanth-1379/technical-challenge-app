<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_card_bg">

    <!-- Top Row: Category/Topic & Difficulty Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_topic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Flutter &amp; Dart"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#93C5FD" />

        <TextView
            android:id="@+id/widget_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FDBA74"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/widget_badge_bg" />
    </LinearLayout>

    <!-- Main Question Text (Prominent, Large, Bold) -->
    <TextView
        android:id="@+id/widget_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Explain the difference between StatelessWidget and StatefulWidget in Flutter."
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:textColor="#FFFFFF"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <!-- Action Button Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Answer Now ➔"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:background="@drawable/widget_btn_bg" />
    </LinearLayout>

</LinearLayout>
